# Copy to reader/.env (mode 600). Never commit the real file.
READER_KEYS=
TUNNEL_TOKEN=
# VLM_MODEL=qwen3-vl:8b-instruct
# READER_PARALLEL=2

# The vision model: Ollama on this machine's GPU (default), or an OpenAI-compatible server such as vLLM.
# VLM_API=ollama
# With VLM_API=openai (the ollama and model services of compose.yml are then not used):
# VLM_URL=https://qwen.example/v1        # base URL ending in /v1
# VLM_KEY=                                # sent as Authorization: Bearer ...
# VLM_MODEL=redhataiqwen36-35b-a3b
# VLM_CA_BUNDLE=/certs/ca.pem             # PEM with the server's CA; default: the system CAs
# VLM_VERIFY_TLS=1                        # 0 = no certificate check (last resort, warned at start)
