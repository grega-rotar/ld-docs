# Kopirajte v .env (chmod 600) in vpišite prave vrednosti. Prave datoteke .env nikoli ne dajte v git.
# Copy to .env (chmod 600) and fill in the real values. Never commit the real .env.
# Vse spremenljivke: docs/zpiz-namestitev.md, "Nastavitve".

# Različica slik (git sha); latest = zadnja. / Image version (git sha); latest = the newest.
IMAGE_TAG=latest
# Naslov, na katerem posluša API (127.0.0.1, če je pred njim reverse proxy na istem VM). / Bind address.
HTTP_BIND=0.0.0.0
# Vrata na VM za spletno stran in API. / Port on the VM for the page and the API.
HTTP_PORT=8080
# Vrata bralnika, samo na 127.0.0.1; spremenite, če so 8100 zasedena. / Reader port, 127.0.0.1 only.
READER_PORT=8100

# Ključi za dostop, ločeni z vejico, en na odjemalca (openssl rand -hex 32). / API keys, comma-separated.
API_KEYS=zamenjaj-kljuc-referentov,zamenjaj-kljuc-drugega-odjemalca
# Ključ med API in bralnikom; compose ga da obema (openssl rand -hex 32). / Shared api-reader key.
READER_KEY=zamenjaj-kljuc-bralnika

# openai = vLLM / OpenShift AI (OpenAI-compatible API). / Vision model API type.
VLM_API=openai
# Osnovni URL modela, konča se z /v1. / Base URL of the vision model, ending in /v1.
VLM_URL=https://zamenjaj-ime-modela.apps.zamenjaj-gruca.zpiz.si/v1
# Žeton service accounta ali ključ MaaS (Authorization: Bearer). / Service-account token or MaaS key.
VLM_KEY=zamenjaj-zeton
# Ime modela, kot ga vrne GET {VLM_URL}/models. / Model id as listed by GET {VLM_URL}/models.
VLM_MODEL=qwen3.6/redhataiqwen36-35b-a3b
# 0 = certifikat gruče se ne preverja, certifikati niso potrebni. / 0 = the cluster's certificate is not checked.
VLM_VERIFY_TLS=0
# Koliko sekund čakamo na en odgovor modela. / Seconds to wait for one vision-model answer.
VLM_TIMEOUT=300
# Koliko žetonov model lahko »razmišlja« pred vsakim odgovorom; 0, če je razmišljanje na strežniku izklopljeno.
# Tokens the model may think before each answer; 0 when thinking is turned off on the model server.
VLM_THINKING_TOKENS=8000
# Koliko sekund API čaka na en dokument. / Seconds the api waits for one document.
READER_TIMEOUT=900

# Po koliko dneh se rezultati izbrišejo (osebni podatki). / Days before results are deleted.
JOB_TTL_DAYS=7
# Koliko dokumentov paketa API hkrati pošlje bralniku. / Batch documents sent to the reader at once.
LOCAL_PARALLEL=3
# Koliko dokumentov bralnik hkrati bere (približno 1 na vCPU). / Documents the reader reads at once.
READER_PARALLEL=2
